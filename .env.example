NODE_PORT=5050
NODE_BASE_URL=http://localhost:5050

MEDIA_ICE_PORT=8189
MEDIA_ICE_IP=127.0.0.1

# test = color bars in Docker
# v4l2 = HDMI capture card as /dev/video0 (Windows: attach USB with scripts/usb.ps1 first)
CAPTURE_SOURCE=test
CAPTURE_DEVICE=/dev/video0
CAPTURE_FORMAT=mjpeg
# HDMI audio is a separate ALSA device, not /dev/video0. Empty = video only (lowest latency).
# List cards: docker compose --profile node exec media cat /proc/asound/cards
# Then e.g. CAPTURE_AUDIO=hw:0,0  (secondary: late audio must not delay video)
CAPTURE_AUDIO=
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080
CAPTURE_FPS=60
# CPU default. NVIDIA: keep this line and start with docker-compose.gpu.yml
# (the overlay forces h264_nvenc and attaches the GPU). Overlay without GPU = media exits.
FFMPEG_ENCODER=libx264
FFMPEG_EXTRA=

PICO_SERIAL=

CLIENT_PORT=5000
