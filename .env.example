COMPOSE_PROFILES=all
# NVIDIA: uncomment COMPOSE_FILE (needs Container Toolkit). Overlay without a GPU = media exits.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

NODE_PORT=5050
NODE_BASE_URL=http://localhost:5050

MEDIA_ICE_PORT=8189
MEDIA_ICE_IP=127.0.0.1

# test = color bars. v4l2 = HDMI capture card.
CAPTURE_SOURCE=test
CAPTURE_DEVICE=/dev/video0
# HDMI audio (cat /proc/asound/cards), e.g. hw:0,0. Empty = silence.
CAPTURE_AUDIO=
# Raw YUY2. Use mjpeg if USB drops frames.
CAPTURE_FORMAT=yuyv422
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080
CAPTURE_FPS=60

# Pico UART (ls /dev/ttyUSB*). Empty = video only, Play does nothing on the Switch.
PICO_SERIAL=

# Sleep wake (Pico 2 W). python3 scripts/wake-scan.py (README "Sleep wake").
SWITCH_BT_MAC=
CONTROLLER_BT_MAC=
CONTROLLER_BT_PID=

CLIENT_PORT=5000
