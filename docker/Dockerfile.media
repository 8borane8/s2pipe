FROM debian:bookworm-slim

ARG MEDIAMTX_VERSION=1.15.3

RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		ca-certificates \
		curl \
		ffmpeg \
	&& arch="$(dpkg --print-architecture)" \
	&& case "$arch" in \
		amd64) mtx_arch="linux_amd64" ;; \
		arm64) mtx_arch="linux_arm64" ;; \
		*) echo "unsupported architecture: $arch" && exit 1 ;; \
	esac \
	&& curl -fsSL "https://github.com/bluenviron/mediamtx/releases/download/v${MEDIAMTX_VERSION}/mediamtx_v${MEDIAMTX_VERSION}_${mtx_arch}.tar.gz" \
		| tar -xz -C /usr/local/bin mediamtx \
	&& apt-get purge -y curl \
	&& apt-get autoremove -y \
	&& rm -rf /var/lib/apt/lists/*

COPY docker/media-init.sh /media-init.sh

ENTRYPOINT ["/bin/bash", "/media-init.sh"]
